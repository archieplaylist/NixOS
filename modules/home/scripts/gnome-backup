#!/usr/bin/env bash
# gnome-backup — backup / restore GNOME dconf + extensions
# Works on any distro (NixOS, Fedora, Ubuntu, etc.) with dconf installed.
# Installed via home-manager to ~/.local/bin/gnome-backup (on PATH).
#
# Usage:
#   gnome-backup backup [options]        # create timestamped bundle
#   gnome-backup restore <file> [opts]   # restore from bundle or .dconf
#   gnome-backup list                    # list backups
#   gnome-backup show <file>             # show backup contents
#   gnome-backup diff <file>             # diff backup vs current
#   gnome-backup to-nix <file>           # convert dump to home-manager Nix snippet
#   gnome-backup help
#
# Backup bundle (tar.gz) contains:
#   dconf-full.dconf          dconf dump /                    (everything)
#   dconf-gnome.dconf         dconf dump /org/gnome/          (GNOME subtree)
#   dconf-shell.dconf         dconf dump /org/gnome/shell/    (shell + extensions settings)
#   extensions.txt            gnome-extensions list + enabled list
#   extensions.tar.gz         ~/.local/share/gnome-shell/extensions (if any, optional)
#   keybindings.dconf         dconf dump /org/gnome/desktop/wm/keybindings/
#   manifest.txt              host, date, GNOME version, etc.
#
# Restore:   dconf load / < dconf-full.dconf   (or gnome subtree only with --gnome-only)
# Requires relogin or `killall gnome-shell` / reboot for full effect on some keys.
#
set -euo pipefail

# ── config ───────────────────────────────────────────────────────────────
# Repo-aware backup dir: default to <repo>/backups/gnome for portability,
# fallback to XDG_DATA_HOME when repo not found (e.g. standalone install).
detect_repo_root() {
  if [[ -n "${REPO:-}" && -d "$REPO" ]]; then echo "$REPO"; return; fi
  if [[ -n "${NIXOS_REPO:-}" && -d "$NIXOS_REPO" ]]; then echo "$NIXOS_REPO"; return; fi
  if [[ -d "$HOME/NixOS" ]]; then echo "$HOME/NixOS"; return; fi
  if [[ -d "$HOME/nixos" ]]; then echo "$HOME/nixos"; return; fi
  local gr; gr=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [[ -n "$gr" && -d "$gr" ]]; then echo "$gr"; return; fi
  echo ""
}
REPO_ROOT="$(detect_repo_root)"
if [[ -n "$REPO_ROOT" && -d "$REPO_ROOT" ]]; then
  DEFAULT_BACKUP_DIR="$REPO_ROOT/backups/gnome"
else
  DEFAULT_BACKUP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-backups"
fi
: "${BACKUP_DIR:=$DEFAULT_BACKUP_DIR}"
# fallbacks for list discovery (repo + XDG + legacy)
FALLBACK_DIR="$HOME/gnome-backups"
XDG_BACKUP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/gnome-backups"
USER_EXT_DIR="$HOME/.local/share/gnome-shell/extensions"
DCONF_USER_DB="$HOME/.config/dconf/user"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; BLUE='\033[0;34m'; DIM='\033[0;90m'; NC='\033[0m'

info()  { echo -e "${BLUE}[info]${NC} $*"; }
ok()    { echo -e "${GREEN}[ok]${NC} $*"; }
warn()  { echo -e "${YELLOW}[warn]${NC} $*"; }
err()   { echo -e "${RED}[error]${NC} $*" >&2; }
die()   { err "$*"; exit 1; }

need_cmd() { command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"; }

usage() {
  cat <<'EOF'
gnome-backup — backup / restore GNOME configuration (dconf + extensions)

USAGE
  gnome-backup backup [OPTIONS]
  gnome-backup restore <FILE> [OPTIONS]
  gnome-backup list
  gnome-backup show <FILE>
  gnome-backup diff <FILE>
  gnome-backup to-nix <FILE> [OPTIONS]
  gnome-backup help

COMMANDS
  backup              Create a timestamped backup bundle (default: <repo>/backups/gnome)
  restore <file>      Restore from bundle (.tar.gz) or raw dump (.dconf/.ini)
  list                List backups in <repo>/backups/gnome, XDG and ~/gnome-backups
  show <file>         Show backup contents / manifest / dconf preview
  diff <file>         Diff backup vs current dconf (unified diff)
  to-nix <file>       Convert dump to Nix home-manager dconf.settings snippet
  help                Show this help

BACKUP OPTIONS
  --dir DIR           Backup directory (default: <repo>/backups/gnome or $XDG_DATA_HOME/gnome-backups)
  --gnome-only        Only dump /org/gnome/ instead of full db (smaller)
  --raw FILE          Also write single raw file (dconf dump / > FILE)
  --no-extensions     Skip bundling ~/.local/share/gnome-shell/extensions
  --include-user-db   Also copy binary dconf DB (~/.config/dconf/user) into bundle
  -y, --yes           Non-interactive (skip confirmations where applicable)

RESTORE OPTIONS
  --gnome-only        Only restore /org/gnome/ subtree (from dconf-gnome.dconf)
  --shell-only        Only restore /org/gnome/shell/ subtree
  --dry-run           Show what would be done, don't write
  --no-extensions     Don't restore extensions.tar.gz even if present
  --force, -y         Skip confirmation prompt
  --no-backup         Don't create pre-restore safety backup

TO-NIX OPTIONS
  --out FILE          Write Nix snippet to FILE (default: stdout)
  --prefix PATH       dconf prefix to include (default: /org/gnome/)
  --full              Convert full dump instead of gnome subtree

ENV
  BACKUP_DIR          Override backup directory (env var)

EXAMPLES
  # backup everything (recommended) — stored in <repo>/backups/gnome/
  gnome-backup backup
  gnome-backup backup --dir ./backups/gnome   # explicit repo dir
  gnome-backup backup --gnome-only --no-extensions
  BACKUP_DIR=~/.local/share/gnome-backups gnome-backup backup  # override to XDG

  # list / inspect (checks repo + XDG)
  gnome-backup list
  gnome-backup show ./backups/gnome/gnome-backup-*.tar.gz
  gnome-backup show ~/.local/share/gnome-backups/gnome-backup-*.tar.gz
  gnome-backup diff ./backups/gnome/gnome-backup-*.tar.gz

  # restore (creates pre-restore backup automatically)
  gnome-backup restore ./backups/gnome/gnome-backup-*.tar.gz
  gnome-backup restore ./my-gnome.dconf --dry-run
  gnome-backup restore ./bundle.tar.gz --gnome-only --force

  # convert to Nix for home-manager (modules/home/gnome.nix)
  gnome-backup to-nix ./backups/gnome/gnome-backup-*.tar.gz --out /tmp/gnome-dconf.nix

NOTES
  • Uses: dconf dump /  and  dconf load / < file   (same format as `gsettings`)
  • Extensions: `gnome-extensions list` is informational; extensions themselves are
    in ~/.local/share/gnome-shell/extensions (bundled if present). System extensions
    from NixOS (pkgs.gnomeExtensions.*) are reinstalled via configuration.nix, not backup.
  • After restore, log out/in or restart GNOME Shell (Wayland: logout, X11: Alt+F2 → r).
  • On NixOS with home-manager dconf.settings, imperative `dconf load` may be
    overwritten on next `home-manager switch` / `nixos-rebuild switch`.

EOF
}

# ── helpers ──────────────────────────────────────────────────────────────
ensure_backup_dir() {
  mkdir -p "$BACKUP_DIR"
}

timestamp() { date +"%Y%m%d-%H%M%S"; }

gnome_version() {
  gnome-shell --version 2>/dev/null || echo "unknown"
}

write_manifest() {
  local dir="$1"
  {
    echo "date=$(date -Iseconds)"
    echo "host=$(hostname)"
    echo "user=$USER"
    echo "gnome=$(gnome_version)"
    echo "distro=$(grep -m1 PRETTY_NAME /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '\"' || echo unknown)"
    echo "kernel=$(uname -r)"
    echo "dconf=available"
    echo "extensions_enabled=$(gnome-extensions list --enabled 2>/dev/null | tr '\n' ',' || echo none)"
    echo "extensions_all=$(gnome-extensions list 2>/dev/null | tr '\n' ',' || echo none)"
  } > "$dir/manifest.txt"
}

# extract bundle to temp dir, echo temp dir; caller must trap cleanup
extract_bundle() {
  local file="$1" tmp
  tmp=$(mktemp -d)
  if [[ "$file" == *.tar.gz || "$file" == *.tgz || "$file" == *.tar ]]; then
    tar -xzf "$file" -C "$tmp" 2>/dev/null || tar -xf "$file" -C "$tmp"
    # if bundle contains single top-level dir, descend into it
    local entries
    entries=("$tmp"/*)
    if [[ ${#entries[@]} -eq 1 && -d "${entries[0]}" ]]; then
      echo "${entries[0]}"
    else
      echo "$tmp"
    fi
  elif [[ "$file" == *.dconf || "$file" == *.ini ]]; then
    # raw dump: copy into tmp as dconf-full.dconf
    cp "$file" "$tmp/dconf-full.dconf"
    # try to also provide gnome subtree if file was full dump: extract relevant sections later
    echo "$tmp"
  else
    # try tar anyway, else treat as raw
    if tar -tzf "$file" >/dev/null 2>&1; then
      tar -xzf "$file" -C "$tmp"
      echo "$tmp"
    else
      cp "$file" "$tmp/dconf-full.dconf"
      echo "$tmp"
    fi
  fi
}

# ── backup ───────────────────────────────────────────────────────────────
do_backup() {
  local gnome_only=0 no_extensions=0 include_user_db=0 raw_file="" yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --gnome-only) gnome_only=1; shift ;;
      --no-extensions) no_extensions=1; shift ;;
      --include-user-db) include_user_db=1; shift ;;
      --raw) raw_file="${2:-}"; [[ -n "$raw_file" ]] || die "--raw requires FILE"; shift 2 ;;
      --dir) BACKUP_DIR="$2"; shift 2 ;;
      -y|--yes) yes=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown backup option: $1 (see --help)" ;;
    esac
  done

  need_cmd dconf
  ensure_backup_dir

  local ts; ts=$(timestamp)
  local workdir; workdir=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$workdir'" EXIT
  local bundle_name="gnome-backup-$ts"
  local stage="$workdir/$bundle_name"
  mkdir -p "$stage"

  info "backing up GNOME config → $BACKUP_DIR/$bundle_name.tar.gz"
  [[ $gnome_only -eq 1 ]] && info "mode: gnome-only (/org/gnome/)" || info "mode: full (dconf dump /)"

  # dconf dumps — never fail the whole backup if one path is empty
  if [[ $gnome_only -eq 0 ]]; then
    dconf dump / > "$stage/dconf-full.dconf" 2>/dev/null || echo "# empty" > "$stage/dconf-full.dconf"
  else
    echo "# gnome-only backup — full dump omitted" > "$stage/dconf-full.dconf"
  fi
  dconf dump /org/gnome/ > "$stage/dconf-gnome.dconf" 2>/dev/null || echo "# empty" > "$stage/dconf-gnome.dconf"
  dconf dump /org/gnome/shell/ > "$stage/dconf-shell.dconf" 2>/dev/null || echo "# empty" > "$stage/dconf-shell.dconf"
  dconf dump /org/gnome/desktop/wm/keybindings/ > "$stage/keybindings.dconf" 2>/dev/null || echo "# empty" > "$stage/keybindings.dconf"
  dconf dump /org/gnome/settings-daemon/plugins/media-keys/ > "$stage/media-keys.dconf" 2>/dev/null || echo "# empty" > "$stage/media-keys.dconf"
  dconf dump /org/gnome/mutter/ > "$stage/mutter.dconf" 2>/dev/null || echo "# empty" > "$stage/mutter.dconf"

  # extensions (informational)
  {
    echo "# gnome-extensions list --enabled"
    gnome-extensions list --enabled 2>/dev/null || echo "(no gnome-extensions or no enabled extensions)"
    echo ""
    echo "# gnome-extensions list (all)"
    gnome-extensions list 2>/dev/null || echo "(no gnome-extensions)"
    echo ""
    echo "# gnome-extensions list --details (if available)"
    gnome-extensions list --details 2>/dev/null || true
  } > "$stage/extensions.txt" 2>/dev/null || echo "(failed to query extensions)" > "$stage/extensions.txt"

  # extension folders
  if [[ $no_extensions -eq 0 && -d "$USER_EXT_DIR" && -n "$(ls -A "$USER_EXT_DIR" 2>/dev/null)" ]]; then
    info "bundling extensions from $USER_EXT_DIR"
    tar -czf "$stage/extensions.tar.gz" -C "$(dirname "$USER_EXT_DIR")" "$(basename "$USER_EXT_DIR")" 2>/dev/null || warn "failed to tar extensions"
  else
    if [[ $no_extensions -eq 1 ]]; then
      echo "# skipped (--no-extensions)" > "$stage/extensions.txt.skipped"
    elif [[ ! -d "$USER_EXT_DIR" ]]; then
      info "no user extensions dir ($USER_EXT_DIR) — skipping"
    fi
  fi

  # optional binary db
  if [[ $include_user_db -eq 1 && -f "$DCONF_USER_DB" ]]; then
    cp "$DCONF_USER_DB" "$stage/dconf-user-db" 2>/dev/null || warn "failed to copy $DCONF_USER_DB"
    info "included binary dconf DB ($DCONF_USER_DB)"
  fi

  write_manifest "$stage"

  # create tar.gz bundle
  local out="$BACKUP_DIR/$bundle_name.tar.gz"
  tar -czf "$out" -C "$workdir" "$bundle_name"
  rm -rf "$workdir"
  trap - EXIT

  # optional raw file copy
  if [[ -n "$raw_file" ]]; then
    mkdir -p "$(dirname "$raw_file")"
    if [[ $gnome_only -eq 1 ]]; then
      cp "$out" "$raw_file" 2>/dev/null || dconf dump /org/gnome/ > "$raw_file"
      # if raw_file was meant to be a plain dconf, extract the gnome dump
      local tmp2; tmp2=$(mktemp -d); trap 'rm -rf "$tmp2"' EXIT
      tar -xzf "$out" -C "$tmp2"
      cp "$tmp2/$bundle_name/dconf-gnome.dconf" "$raw_file"
      rm -rf "$tmp2"; trap - EXIT
    else
      local tmp2; tmp2=$(mktemp -d); trap 'rm -rf "$tmp2"' EXIT
      tar -xzf "$out" -C "$tmp2"
      cp "$tmp2/$bundle_name/dconf-full.dconf" "$raw_file"
      rm -rf "$tmp2"; trap - EXIT
    fi
    ok "raw dump also written to $raw_file"
  fi

  # summary
  local size; size=$(du -h "$out" | cut -f1)
  ok "backup created: $out ($size)"
  echo -e "${DIM}  contains: dconf-full.dconf, dconf-gnome.dconf, dconf-shell.dconf, extensions.txt${NC}"
  if [[ -f "$stage/extensions.tar.gz" ]]; then echo -e "${DIM}            + extensions.tar.gz (user extensions)${NC}"; fi 2>/dev/null || true
  # show quick preview
  echo ""
  info "preview (first 20 lines of dconf-gnome.dconf):"
  tar -xzf "$out" -O "$bundle_name/dconf-gnome.dconf" 2>/dev/null | head -n 20 | sed 's/^/  /' || true
  echo ""
  info "to restore: $0 restore $out"
  info "to list:    $0 list"
}

# ── restore ──────────────────────────────────────────────────────────────
do_restore() {
  local file="" gnome_only=0 shell_only=0 dry_run=0 no_extensions=0 force=0 no_backup=0
  # first arg may be file without flag
  if [[ $# -gt 0 && "$1" != --* ]]; then file="$1"; shift; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --gnome-only) gnome_only=1; shift ;;
      --shell-only) shell_only=1; shift ;;
      --dry-run) dry_run=1; shift ;;
      --no-extensions) no_extensions=1; shift ;;
      --force|-y|--yes) force=1; shift ;;
      --no-backup) no_backup=1; shift ;;
      --dir) BACKUP_DIR="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) if [[ -z "$file" && -f "$1" ]]; then file="$1"; shift; else die "unknown restore option: $1"; fi ;;
    esac
  done
  [[ -n "$file" ]] || die "restore requires a FILE argument (bundle .tar.gz or raw .dconf)"
  [[ -f "$file" ]] || die "file not found: $file"
  need_cmd dconf

  local src_dir src_file tmp_root
  tmp_root=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp_root'" EXIT

  # detect type
  if [[ "$file" == *.dconf || "$file" == *.ini ]] && ! tar -tzf "$file" >/dev/null 2>&1; then
    # raw dump
    info "detected raw dconf dump: $file"
    mkdir -p "$tmp_root/raw"
    cp "$file" "$tmp_root/raw/dconf-full.dconf"
    # also create gnome view by filtering? for now use same file for gnome-only fallback
    cp "$file" "$tmp_root/raw/dconf-gnome.dconf"
    cp "$file" "$tmp_root/raw/dconf-shell.dconf"
    src_dir="$tmp_root/raw"
  else
    info "extracting bundle: $file"
    tar -tzf "$file" >/dev/null 2>&1 || die "not a valid tar.gz bundle: $file"
    tar -xzf "$file" -C "$tmp_root"
    # find the bundle dir
    local found
    found=$(find "$tmp_root" -maxdepth 2 -name "dconf-full.dconf" -o -name "dconf-gnome.dconf" | head -n1)
    if [[ -z "$found" ]]; then die "bundle doesn't contain dconf dumps (expected dconf-*.dconf)"; fi
    src_dir=$(dirname "$found")
  fi

  # choose source file based on restore mode
  if [[ $shell_only -eq 1 ]]; then
    src_file="$src_dir/dconf-shell.dconf"
    [[ -f "$src_file" ]] || die "bundle has no dconf-shell.dconf (try without --shell-only)"
    info "restore mode: shell-only (/org/gnome/shell/)"
  elif [[ $gnome_only -eq 1 ]]; then
    src_file="$src_dir/dconf-gnome.dconf"
    [[ -f "$src_file" ]] || die "bundle has no dconf-gnome.dconf"
    info "restore mode: gnome-only (/org/gnome/)"
  else
    src_file="$src_dir/dconf-full.dconf"
    # fallback if full is placeholder and gnome exists
    if [[ ! -s "$src_file" || "$(head -n1 "$src_file")" == *"gnome-only backup"* ]]; then
      if [[ -s "$src_dir/dconf-gnome.dconf" ]]; then
        warn "full dump is empty/placeholder, falling back to gnome subtree"
        src_file="$src_dir/dconf-gnome.dconf"
        gnome_only=1
      fi
    fi
    [[ -s "$src_file" ]] || die "source dconf file is empty: $src_file"
    if [[ $gnome_only -eq 0 && $shell_only -eq 0 ]]; then
      info "restore mode: full (dconf load /)"
    fi
  fi

  # show manifest if present
  if [[ -f "$src_dir/manifest.txt" ]]; then
    echo ""
    info "backup manifest:"
    sed 's/^/  /' "$src_dir/manifest.txt"
    echo ""
  fi
  if [[ -f "$src_dir/extensions.txt" ]]; then
    info "extensions in backup:"
    head -n 20 "$src_dir/extensions.txt" | sed 's/^/  /'
    echo ""
  fi

  # safety backup before restore
  if [[ $no_backup -eq 0 && $dry_run -eq 0 ]]; then
    ensure_backup_dir
    local safety="$BACKUP_DIR/pre-restore-$(timestamp).dconf"
    info "creating safety backup: $safety"
    dconf dump / > "$safety" 2>/dev/null || warn "failed to create safety backup"
    ok "safety backup saved (restore with: $0 restore $safety)"
    echo ""
  fi

  # preview diff size
  local lines; lines=$(wc -l < "$src_file")
  info "source: $src_file ($lines lines)"
  info "preview (first 30 lines):"
  head -n 30 "$src_file" | sed 's/^/  /'
  echo ""

  # extensions restore preview
  local has_ext=0
  if [[ -f "$src_dir/extensions.tar.gz" ]]; then has_ext=1; fi
  if [[ $has_ext -eq 1 && $no_extensions -eq 0 ]]; then
    info "bundle contains user extensions (extensions.tar.gz) — will restore to $USER_EXT_DIR"
  elif [[ $has_ext -eq 1 && $no_extensions -eq 1 ]]; then
    info "bundle contains extensions.tar.gz — skipping (--no-extensions)"
  fi

  if [[ $dry_run -eq 1 ]]; then
    warn "dry-run: no changes will be made"
    echo ""
    if [[ $shell_only -eq 1 ]]; then
      echo "would run: dconf load /org/gnome/shell/ < \"$src_file\""
    elif [[ $gnome_only -eq 1 ]]; then
      echo "would run: dconf load /org/gnome/ < \"$src_file\""
    else
      echo "would run: dconf load / < \"$src_file\""
    fi
    if [[ $has_ext -eq 1 && $no_extensions -eq 0 ]]; then
      echo "would run: tar -xzf \"$src_dir/extensions.tar.gz\" -C \"$HOME/.local/share/gnome-shell/\""
    fi
    trap - EXIT; rm -rf "$tmp_root"
    return 0
  fi

  if [[ $force -eq 0 ]]; then
    echo -e "${YELLOW}This will overwrite your current GNOME settings.${NC}"
    if [[ $gnome_only -eq 1 ]]; then echo -e "${YELLOW}Scope: /org/gnome/ only${NC}"
    elif [[ $shell_only -eq 1 ]]; then echo -e "${YELLOW}Scope: /org/gnome/shell/ only${NC}"
    else echo -e "${YELLOW}Scope: FULL dconf DB (/)${NC}"; fi
    read -rp "Continue? [y/N] " ans
    [[ "$ans" == [yY] || "$ans" == [yY][eE][sS] ]] || { info "aborted"; trap - EXIT; rm -rf "$tmp_root"; exit 0; }
  fi

  # do restore
  if [[ $shell_only -eq 1 ]]; then
    info "restoring: dconf load /org/gnome/shell/ < $src_file"
    dconf load /org/gnome/shell/ < "$src_file"
  elif [[ $gnome_only -eq 1 ]]; then
    info "restoring: dconf load /org/gnome/ < $src_file"
    dconf load /org/gnome/ < "$src_file"
  else
    info "restoring: dconf load / < $src_file"
    dconf load / < "$src_file"
  fi
  ok "dconf restore complete"

  # restore extensions
  if [[ $has_ext -eq 1 && $no_extensions -eq 0 ]]; then
    info "restoring extensions to $USER_EXT_DIR"
    mkdir -p "$(dirname "$USER_EXT_DIR")"
    # backup existing extensions
    if [[ -d "$USER_EXT_DIR" && -n "$(ls -A "$USER_EXT_DIR" 2>/dev/null)" ]]; then
      local ext_bak="$BACKUP_DIR/extensions-pre-restore-$(timestamp).tar.gz"
      tar -czf "$ext_bak" -C "$(dirname "$USER_EXT_DIR")" "$(basename "$USER_EXT_DIR")" 2>/dev/null || true
      info "backed up current extensions to $ext_bak"
    fi
    tar -xzf "$src_dir/extensions.tar.gz" -C "$HOME/.local/share/gnome-shell/" 2>/dev/null || \
    tar -xzf "$src_dir/extensions.tar.gz" -C "$HOME/.local/share/" 2>/dev/null || \
    { warn "failed to extract extensions.tar.gz"; }
    ok "extensions restored — you may need to re-enable them: gnome-extensions enable <uuid>"
    if [[ -f "$src_dir/extensions.txt" ]]; then
      info "to re-enable previously enabled extensions:"
      grep -v "^#" "$src_dir/extensions.txt" | head -n 20 | while read -r uuid; do
        [[ -z "$uuid" || "$uuid" == "("* ]] && continue
        echo "  gnome-extensions enable $uuid"
      done
    fi
  fi

  trap - EXIT; rm -rf "$tmp_root"
  echo ""
  ok "restore done — log out/in or restart GNOME Shell for all changes to apply"
  warn "NixOS note: if you use home-manager dconf.settings, next 'nixos-rebuild switch' may overwrite these"
}

# ── list / show / diff ─────────────────────────────────────────────────
do_list() {
  # build unique list: BACKUP_DIR + repo + XDG + legacy
  local dirs=()
  local seen=""
  add_dir() { [[ " $seen " == *" $1 "* ]] || { dirs+=("$1"); seen+=" $1 "; }; }
  add_dir "$BACKUP_DIR"
  if [[ -n "$REPO_ROOT" && -d "$REPO_ROOT" ]]; then add_dir "$REPO_ROOT/backups/gnome"; fi
  add_dir "$XDG_BACKUP_DIR"
  add_dir "$FALLBACK_DIR"
  local found=0
  for d in "${dirs[@]}"; do
    if [[ -d "$d" ]]; then
      echo -e "${BLUE}Backups in $d:${NC}"
      # shellcheck disable=SC2012
      ls -lh "$d" 2>/dev/null | grep -E "gnome|dconf|pre-restore" || echo "  (none)"
      echo ""
      found=1
    fi
  done
  if [[ $found -eq 0 ]]; then
    info "no backup dir yet — run: $0 backup"
    info "would create: $BACKUP_DIR (repo: $REPO_ROOT/backups/gnome if repo exists)"
  fi
  # also show current dconf size
  if command -v dconf >/dev/null 2>&1; then
    echo -e "${DIM}Current dconf:${NC} $(dconf dump / 2>/dev/null | wc -l) lines, $(dconf dump /org/gnome/ 2>/dev/null | wc -l) lines in /org/gnome/"
  fi
}

do_show() {
  local file="${1:-}"; [[ -n "$file" ]] || die "show requires FILE argument"
  [[ -f "$file" ]] || die "file not found: $file"
  if tar -tzf "$file" >/dev/null 2>&1; then
    echo -e "${BLUE}Bundle contents: $file${NC}"
    tar -tzf "$file" | sed 's/^/  /'
    echo ""
    local tmp; tmp=$(mktemp -d); trap "rm -rf '$tmp'" EXIT
    tar -xzf "$file" -C "$tmp"
    local manifest; manifest=$(find "$tmp" -name "manifest.txt" | head -n1)
    if [[ -n "$manifest" ]]; then
      echo -e "${BLUE}Manifest:${NC}"; sed 's/^/  /' "$manifest"; echo ""
    fi
    local dconf; dconf=$(find "$tmp" -name "dconf-gnome.dconf" | head -n1)
    if [[ -n "$dconf" ]]; then
      echo -e "${BLUE}Preview (dconf-gnome.dconf, first 60 lines):${NC}"; head -n 60 "$dconf" | sed 's/^/  /'
    fi
    local ext; ext=$(find "$tmp" -name "extensions.txt" | head -n1)
    if [[ -n "$ext" ]]; then
      echo ""; echo -e "${BLUE}Extensions:${NC}"; sed 's/^/  /' "$ext"
    fi
    rm -rf "$tmp"; trap - EXIT
  else
    echo -e "${BLUE}Raw dconf dump: $file ($(wc -l < "$file") lines)${NC}"
    head -n 80 "$file" | sed 's/^/  /'
    [[ $(wc -l < "$file") -gt 80 ]] && echo "  ... ($(wc -l < "$file") total lines)"
  fi
}

do_diff() {
  local file="${1:-}"; [[ -n "$file" ]] || die "diff requires FILE argument"
  [[ -f "$file" ]] || die "file not found: $file"
  need_cmd dconf
  local tmp; tmp=$(mktemp -d); trap "rm -rf '$tmp'" EXIT
  local src_file
  if tar -tzf "$file" >/dev/null 2>&1; then
    tar -xzf "$file" -C "$tmp"
    src_file=$(find "$tmp" -name "dconf-full.dconf" | head -n1)
    # if full is placeholder, use gnome
    if [[ -n "$src_file" && "$(head -n1 "$src_file")" == *"gnome-only backup"* ]]; then
      src_file=$(find "$tmp" -name "dconf-gnome.dconf" | head -n1)
    fi
    [[ -n "$src_file" ]] || src_file=$(find "$tmp" -name "*.dconf" | head -n1)
  else
    src_file="$file"
  fi
  [[ -n "$src_file" && -f "$src_file" ]] || die "no dconf file found in bundle"
  local current="$tmp/current.dconf"
  dconf dump / > "$current" 2>/dev/null || die "failed to dump current dconf"
  info "diff: backup ($src_file) vs current (dconf dump /)"
  echo -e "${DIM}--- backup${NC}"
  echo -e "${DIM}+++ current${NC}"
  diff -u "$src_file" "$current" | head -n 500 || true
  if diff -q "$src_file" "$current" >/dev/null 2>&1; then ok "no difference"; else warn "differences shown above (truncated to 500 lines)"; fi
  rm -rf "$tmp"; trap - EXIT
}

# ── to-nix ───────────────────────────────────────────────────────────────
do_to_nix() {
  local file="" out="" prefix="/org/gnome/" full=0
  if [[ $# -gt 0 && "$1" != --* ]]; then file="$1"; shift; fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --out) out="$2"; shift 2 ;;
      --prefix) prefix="$2"; shift 2 ;;
      --full) full=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) if [[ -z "$file" && -f "$1" ]]; then file="$1"; shift; else die "unknown to-nix option: $1"; fi ;;
    esac
  done
  [[ -n "$file" ]] || die "to-nix requires FILE argument"
  [[ -f "$file" ]] || die "file not found: $file"

  local tmp; tmp=$(mktemp -d); trap "rm -rf '$tmp'" EXIT
  local src dump_prefix="/"
  if tar -tzf "$file" >/dev/null 2>&1; then
    tar -xzf "$file" -C "$tmp"
    if [[ $full -eq 1 ]]; then src=$(find "$tmp" -name "dconf-full.dconf" | head -n1); dump_prefix="/"
    else src=$(find "$tmp" -name "dconf-gnome.dconf" | head -n1); dump_prefix="/org/gnome/"; fi
    # fallback detection: if gnome file missing try shell or full
    if [[ -z "$src" || ! -f "$src" ]]; then src=$(find "$tmp" -name "dconf-shell.dconf" | head -n1); dump_prefix="/org/gnome/shell/"; fi
    [[ -n "$src" ]] || src=$(find "$tmp" -name "*.dconf" | head -n1)
    # infer dump_prefix from filename if still generic
    if [[ "$src" == *"dconf-gnome.dconf" ]]; then dump_prefix="/org/gnome/"
    elif [[ "$src" == *"dconf-shell.dconf" ]]; then dump_prefix="/org/gnome/shell/"
    elif [[ "$src" == *"dconf-full.dconf" ]]; then dump_prefix="/"
    fi
  else
    src="$file"
    # infer dump_prefix from content: if first section starts with org/ it's full
    if head -n 30 "$src" 2>/dev/null | grep -q "^\[org/"; then dump_prefix="/"
    else dump_prefix="/org/gnome/"; fi
  fi
  [[ -n "$src" && -f "$src" ]] || die "no dconf file found"

  # filter by prefix if needed
  local filtered="$tmp/filtered.dconf"
  if [[ "$prefix" != "/" && $full -eq 0 ]]; then
    # dconf-gnome already filtered; just copy (still need to handle relative sections later)
    cp "$src" "$filtered"
  elif [[ "$prefix" != "/" ]]; then
    # extract sections matching prefix from full dump
    # dconf dump format: [org/gnome/...] sections
    local wanted="${prefix#/}"; wanted="${wanted%/}"
    wanted="${wanted//\//\\/}"
    # crude: include sections starting with wanted
    awk -v p="$wanted" '
      /^\[.*\]/ { cur=$0; keep = (index(cur, p) > 0); }
      keep { print }
      /^\[.*\]/ && keep { print "" }
    ' "$src" > "$filtered" 2>/dev/null || cp "$src" "$filtered"
    # fallback if awk filtered everything
    [[ -s "$filtered" ]] || cp "$src" "$filtered"
  else
    cp "$src" "$filtered"
  fi

  # convert dconf ini -> Nix
  # We use python for robust parsing (handles uint32, tuples, arrays, etc.)
  local py_out="$tmp/out.nix"
  python3 - "$filtered" "$py_out" "$prefix" "$dump_prefix" << 'PY'
import re, sys
src = sys.argv[1]
dst = sys.argv[2]
prefix = sys.argv[3] if len(sys.argv) > 3 else "/org/gnome/"
dump_prefix = sys.argv[4] if len(sys.argv) > 4 else "/org/gnome/"

def nix_escape(s):
    return s.replace("\\", "\\\\").replace('"', '\\"').replace("${", "\\${")

with open(src) as f:
    content = f.read()

# parse ini sections
sections = {}
cur = None
for line in content.splitlines():
    line=line.strip()
    if not line or line.startswith("#"):
        continue
    if line.startswith("[") and line.endswith("]"):
        cur = line[1:-1].strip()
        sections[cur] = {}
        continue
    if cur is None or "=" not in line:
        continue
    k, v = line.split("=", 1)
    sections[cur][k.strip()] = v.strip()

# helper: dconf value -> nix value
# dconf values are already GVariant text, which maps almost directly to Nix
# but need to handle: true/false, numbers, strings in single quotes, arrays, tuples
# Nix dconf.settings expects GVariant strings as Nix values, e.g.:
#   "org/gnome/desktop/interface" = { gtk-theme = "Orchis-Dark"; color-scheme = "prefer-dark"; };
# So we can mostly pass values through, converting single-quoted strings to double-quoted

def convert_val(v):
    v=v.strip()
    # already correct for: true, false, numbers, uint32 123, arrays [...], tuples (...),
    # but strings are single-quoted in dconf dump: 'value'
    # Convert single-quoted strings to Nix double-quoted strings
    # Handle arrays of strings, etc. via regex
    # Simple approach: replace '...' with "..." handling escapes
    # This is heuristic but works for most GNOME keys
    def repl_single(m):
        inner = m.group(1)
        # unescape dconf single-quote escapes: \' -> '
        inner = inner.replace("\\'", "'").replace("\\\\", "\\")
        # escape for Nix double quotes
        inner = nix_escape(inner)
        return f'"{inner}"'
    # replace single-quoted strings (non-greedy, handles escaped \')
    # Use pattern that matches '...' where inner may contain escaped \'
    v = re.sub(r"'((?:[^'\\]|\\.)*)'", repl_single, v)
    # fix uint32 prefix: keep as is, Nix handles it as string? Actually dconf.settings expects "uint32 0" as string
    # but home-manager expects GVariant, so we keep literal and Nix will need to be string.
    # For uint32 values, wrap in quotes if not already? No, keep as is and let Nix infer?
    # Safer: keep "uint32 0" as is — home-manager's dconf module handles it via lib.hm.gvariant.mkUint32
    # but plain string "uint32 0" also works if quoted. We'll keep single token handling:
    # If value is like "uint32 0", we need to keep it quoted for Nix string.
    # Detect standalone uint32
    if re.match(r'^uint32\s+\d+$', v):
        return f'"{v}"'
    return v

# group by dconf path — handle relative sections from subtree dumps
# dump_prefix is the path that was dumped (e.g. /org/gnome/ or /), sections are relative to it
dump_norm = dump_prefix.strip("/")
prefix_norm = prefix.strip("/")
out_lines = []
out_lines.append("# Generated by gnome-backup.sh to-nix — paste into home-manager dconf.settings")
out_lines.append(f"# Source: {src} (dump_prefix={dump_prefix})")
out_lines.append(f"# Prefix: {prefix}")
out_lines.append("# Usage in modules/home/gnome.nix:")
out_lines.append("#   dconf.settings = {")
for section, kv in sorted(sections.items()):
    if not kv:
        continue
    # reconstruct full dconf path if section was relative (subtree dump strips prefix)
    full_section = section
    if not section.startswith("org/"):
        # section is relative to dump_prefix, e.g. "desktop/interface" from /org/gnome/ dump
        if dump_norm:
            full_section = f"{dump_norm}/{section}" if section else dump_norm
        else:
            full_section = section
        # if prefix filter, ensure it matches (already filtered, but keep logic)
    # normalize: remove trailing slash
    full_section = full_section.strip("/")
    out_lines.append(f'    "{full_section}" = {{')
    for k, v in sorted(kv.items()):
        nv = convert_val(v)
        out_lines.append(f'      {k} = {nv};')
    out_lines.append('    };')
out_lines.append("#   };")
out_lines.append("")

with open(dst, "w") as out:
    out.write("\n".join(out_lines))
print(f"wrote {len(sections)} sections to {dst}")
PY

  if [[ -n "$out" ]]; then
    mkdir -p "$(dirname "$out")"
    cp "$py_out" "$out"
    ok "Nix snippet written to $out ($(wc -l < "$out") lines)"
    echo -e "${DIM}Preview:${NC}"
    head -n 50 "$out" | sed 's/^/  /'
  else
    cat "$py_out"
  fi
  rm -rf "$tmp"; trap - EXIT
}

# ── main ─────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"; [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    backup) do_backup "$@" ;;
    restore) do_restore "$@" ;;
    list|ls) do_list "$@" ;;
    show|cat|info) do_show "$@" ;;
    diff) do_diff "$@" ;;
    to-nix|tonix|nix) do_to_nix "$@" ;;
    help|--help|-h) usage ;;
    *) err "unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
