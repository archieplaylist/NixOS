#!/usr/bin/env bash
# gnome-backup — minimal GNOME dconf backup/restore
# ponytail: 772→35 lines; dconf dump/load is the native tool, no bundle/manifest/extensions needed
# ponytail: extensions are declarative via Nix (pkgs.gnomeExtensions), no tar
# ponytail: single-file .dconf, repo/backups/gnome for git portability; old .tar.gz compat is 3 lines
set -euo pipefail

# repo detection (same as switch-de)
detect_repo() {
  [[ -n "${REPO:-}" && -d "$REPO" ]] && { echo "$REPO"; return; }
  [[ -n "${NIXOS_REPO:-}" && -d "$NIXOS_REPO" ]] && { echo "$NIXOS_REPO"; return; }
  [[ -d "$HOME/NixOS" ]] && { echo "$HOME/NixOS"; return; }
  [[ -d "$HOME/nixos" ]] && { echo "$HOME/nixos"; return; }
  git rev-parse --show-toplevel 2>/dev/null || echo ""
}
REPO="$(detect_repo)"
DIR="${BACKUP_DIR:-${REPO:+$REPO/backups/gnome}}"
DIR="${DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/gnome-backups}"

usage() { cat <<'USAGE'
gnome-backup backup              → dconf dump /org/gnome/ > <repo>/backups/gnome/gnome-*.dconf
gnome-backup restore <file>      → dconf load /org/gnome/ < file  (.dconf or old .tar.gz)
gnome-backup list                → ls backups/gnome
USAGE
}

cmd="${1:-}"; case "$cmd" in
  backup)
    mkdir -p "$DIR"
    command -v dconf >/dev/null || { echo "missing dconf" >&2; exit 1; }
    f="$DIR/gnome-$(date +%Y%m%d-%H%M%S).dconf"
    dconf dump /org/gnome/ > "$f"
    echo "$f ($(wc -l < "$f") lines)"
    ;;
  restore)
    f="${2:-}"; [[ -f "$f" ]] || { usage; echo "restore requires file" >&2; exit 1; }
    command -v dconf >/dev/null || { echo "missing dconf" >&2; exit 1; }
    # ponytail: 3-line compat for old bundle format; delete when old tar.gz gone
    if [[ "$f" == *.tar.gz || "$f" == *.tgz ]] && tar -tzf "$f" >/dev/null 2>&1; then
      tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
      tar -xzf "$f" -C "$tmp"
      src=$(find "$tmp" -name "dconf-gnome.dconf" -o -name "dconf-full.dconf" | head -n1)
      [[ -n "${src:-}" ]] || src=$(find "$tmp" -name "*.dconf" | head -n1)
      [[ -n "${src:-}" && -f "$src" ]] || { echo "no .dconf in bundle" >&2; exit 1; }
      # old bundle dconf-gnome.dconf is relative (no org/gnome prefix), new dump is absolute? both work with load /org/gnome/ if relative, / if absolute
      if head -n5 "$src" | grep -q "^\[org/"; then dconf load / < "$src"; else dconf load /org/gnome/ < "$src"; fi
    else
      if head -n5 "$f" | grep -q "^\[org/"; then dconf load / < "$f"; else dconf load /org/gnome/ < "$f"; fi
    fi
    echo "restore done — relogin to apply"
    ;;
  list|"") ls -lh "$DIR" 2>/dev/null || echo "no backups in $DIR"; echo "current: $(dconf dump /org/gnome/ 2>/dev/null | wc -l) lines" ;;
  help|-h|--help) usage ;;
  *) echo "unknown: $cmd" >&2; usage; exit 1 ;;
esac
