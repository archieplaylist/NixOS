/* drun launcher for XFCE — Super_L binding in modules/home/desktops/xfce.nix.
   Palette = canonical ayu-dark (ayu-colors v9), matching polybar: bg
   #0d1017, panel #141821, fg #bfbdb6, dim #5a6378, accent #e6b450. */

configuration {
    modes: "drun";
    show-icons: true;
    /* matches xfconf Net/IconThemeName */
    icon-theme: "MacTahoe-dark";
    font: "Noto Sans 11";
}

* {
    background: rgba ( 13, 16, 23, 85 % );
    bg-alt: rgba ( 20, 24, 33, 85 % );
    fg: #bfbdb6;
    fg-dim: #5a6378;
    accent: #e6b450;
}

window {
    width: 750px;
    border: 1px;
    border-color: @accent;
    padding: 14px;
    background-color: @background;
}

mainbox {
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 8px;
    background-color: @bg-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

entry {
    text-color: @fg;
}

listview {
    lines: 10;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 6px 10px;
    background-color: transparent;
    text-color: @fg;
}

/* pin normal + alternate states so the default theme's alternating
   row backgrounds can't leak through */
element alternate {
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @bg-alt;
    text-color: @accent;
    border-color: @accent;
}

element-icon {
    size: 28px;
}

element-text {
    text-color: @fg;
}

element-text selected {
    text-color: @accent;
}
