;; Window defs. `bar` geometry lives top-left full width (positional bar like
;; the old polybar [bar/main]); the gross windows (searchapps, bigpowermenu,
;; appbar) keep upstream's anchor but re-anchored for xfwm4: appbar sits
;; bottom-center like the old polybar dock. Gross's fetch/quote/sys panels stay
;; defined but off at startup — `eww open fetch` etc. to try them.

;; ---------- gross windows ----------

;; rofi-style search — keyboard input focus, closes when it loses focus
(defwindow searchapps
  :wm-ignore true
  :monitor 0
  :windowtype "normal"
  :geometry (geometry :x "40%"
                      :y "30%"
                      :width "20%"
                      :height "50%"
                      :anchor "top left")
(searchapps))

;; powermenu (gross bigpowermenu) — Super+q
(defwindow bigpowermenu
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "0px"
                      :y "-40px"
                      :width "300px"
                      :height "80px"
                      :anchor "center center")
(bigpowermenu))

;; appbar dock — bottom-center strip, gross geometry flipped to the xfwm4
;; equivalent of the old polybar dock
(defwindow appbar
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "20px"
                      :y "20px"
                      :width "250px"
                      :height "70px"
                      :anchor "bottom center")
(appbar))

;; ---------- gross side panels (manual, not opened at startup) ----------

;; fetch (uinfo) widget window
(defwindow fetch
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "20px"
                      :y "80px"
                      :width "200px"
                      :height "180px"
                      :anchor "top left")
(uinfo))

;; system information window
(defwindow sys
  :class "cpu-win"
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "20px"
                      :y "300px"
                      :width "200px"
                      :height "60px"
                      :anchor "top left")
(sys))

;; random quote window
(defwindow quote
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :geometry (geometry :x "20px"
                      :y "500px"
                      :width "200px"
                      :height "140px"
                      :anchor "top left")
(quote))

;; ---------- bar window (Saimoomedits/eww-widgets) ----------

(defwindow bar
  :wm-ignore true
  :monitor 0
  :windowtype "dock"
  :stacking "fg"
  :geometry (geometry :x "0px"
                      :y "0px"
                      :width "100%"
                      :height "30px"
                      :anchor "top left")
(bar_1))
