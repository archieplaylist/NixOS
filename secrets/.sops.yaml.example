# sops-nix configuration. Copy to .sops.yaml (or run ./setup.sh) and
# replace age1REPLACEME... with your public age key:
#   cat ~/.config/sops/age/keys.txt   (the "public key:" line)
keys:
  - &mario age1REPLACEME...
creation_rules:
  - path_regex: secrets.*\.yaml$
    key_groups:
      - age:
          - *mario